<script src="<?= e(asset('js/webtrees.min.js')) ?>"></script>

<script>
  // Mobile menus - deterministic toggle logic independent of Bootstrap collapse internals.
  (function () {
    var primaryBtn = document.querySelector('.toggle-primary');
    var secondaryBtn = document.querySelector('.toggle-secondary');
    var primaryMenu = document.getElementById('primaryMenuM');
    var secondaryMenu = document.getElementById('secondaryMenuM');

    if (!primaryBtn || !secondaryBtn || !primaryMenu || !secondaryMenu) {
      return;
    }

    function close(button, panel) {
      button.setAttribute('aria-expanded', 'false');
      panel.classList.remove('show');
    }

    function open(button, panel) {
      button.setAttribute('aria-expanded', 'true');
      panel.classList.add('show');
    }

    function toggle(button, panel, otherButton, otherPanel) {
      var isOpen = button.getAttribute('aria-expanded') === 'true';
      close(otherButton, otherPanel);
      if (isOpen) {
        close(button, panel);
      } else {
        open(button, panel);
      }
    }

    close(primaryBtn, primaryMenu);
    close(secondaryBtn, secondaryMenu);

    primaryBtn.addEventListener('click', function (event) {
      event.preventDefault();
      event.stopPropagation();
      toggle(primaryBtn, primaryMenu, secondaryBtn, secondaryMenu);
    });

    secondaryBtn.addEventListener('click', function (event) {
      event.preventDefault();
      event.stopPropagation();
      toggle(secondaryBtn, secondaryMenu, primaryBtn, primaryMenu);
    });
  })();

  // Scroll offset for sticky header
  function adjustScrollPadding (mq) {
    if (mq.matches) {
      var headerHeight = $('.wt-header-wrapper').outerHeight() + 10;
      $('html').css('scroll-padding-top', headerHeight + 'px');
    } else {
      $('html').removeAttr('style');
    }
  }
  var mq = window.matchMedia('(min-width: 992px)');
  adjustScrollPadding(mq);
  if (mq.addEventListener) {
    mq.addEventListener('change', adjustScrollPadding);
  } else if (mq.addListener) {
    mq.addListener(adjustScrollPadding);
  }

  // Highlight active nav item
  var currentUrl = location.href;
  $('.wt-primary-navigation').find('a[href="' + currentUrl + '"]').addClass('active').parents('li').find('.nav-link').addClass('mn-nav-link-active');
  $('.wt-secondary-navigation').find('a[href="' + currentUrl + '"]').addClass('active');
</script>

